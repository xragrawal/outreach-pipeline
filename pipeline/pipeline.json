{
  "project": {
    "name": "icp-to-outreach",
    "date": "2026-11-24"
  },
  "run": "examples/usebuy",
  "stages": [
    {
      "id": 1,
      "key": "icp",
      "name": "ICP generation",
      "question": "Who do we want, what do they sell, and what do we value?",
      "inputs": [
        "company-profile.md",
        "service-catalogue-analysis.md"
      ],
      "outputs": [
        "icp.md",
        "taxonomy.csv"
      ],
      "command": null,
      "gate": "icp",
      "required_sections": [
        "Buyer",
        "Value proposition",
        "Capability surface",
        "Weights",
        "Core capabilities",
        "Anti-ICP",
        "Evidence"
      ]
    },
    {
      "id": 2,
      "key": "source",
      "name": "Sourcing",
      "question": "Which companies could match, and where do we find them?",
      "inputs": [],
      "outputs": [
        "universe.csv"
      ],
      "command": null,
      "gate": "source",
      "source_types": [
        "directory",
        "review site",
        "market report",
        "marketplace catalogue",
        "competitor customer list",
        "funding database"
      ]
    },
    {
      "id": 3,
      "key": "model",
      "name": "Scoring model",
      "question": "Which parameters separate a good match from a bad one, and how much does each count?",
      "inputs": [
        "taxonomy.csv"
      ],
      "outputs": [
        "scoring-model.md"
      ],
      "command": null,
      "gate": "model"
    },
    {
      "id": 4,
      "key": "score",
      "name": "Scoring",
      "question": "How close is each company, and is it reachable?",
      "inputs": [
        "universe.csv",
        "taxonomy.csv"
      ],
      "outputs": [
        "similarity-ranking.csv",
        "similarity-ranking-reachable.csv",
        "similarity-ranking-removed.csv",
        "service-class-coverage.csv"
      ],
      "command": [
        "python3",
        "scripts/rank_similarity.py",
        "--run",
        "{run}"
      ],
      "post_command": [
        [
          "python3",
          "scripts/filter_reachable.py",
          "--run",
          "{run}"
        ],
        [
          "python3",
          "scripts/service_class_coverage.py",
          "--run",
          "{run}"
        ]
      ],
      "gate": "score"
    },
    {
      "id": 5,
      "key": "enrich",
      "name": "Enrichment and outreach handoff",
      "question": "Who do we contact, at which address, and why now?",
      "inputs": [
        "similarity-ranking-reachable.csv"
      ],
      "outputs": [
        "similarity-ranking-contacts.csv",
        "outreach.csv"
      ],
      "command": [
        "python3",
        "scripts/enrich_hunter.py",
        "--run",
        "{run}"
      ],
      "gate": "enrich",
      "requires_credits": true,
      "post_command": [
        "python3",
        "scripts/build_outreach.py",
        "--run",
        "{run}"
      ]
    }
  ]
}
